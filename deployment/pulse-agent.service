[Unit]
Description=Pulse telemetry agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/lib/pulse-agent
ExecStart=/opt/pulse/pulse-agent -url https://monitor.example.com:8443 -server SERVER_ID -token-file /etc/pulse-agent/agent.token -state /var/lib/pulse-agent
Restart=on-failure
RestartSec=5
UMask=0077
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/pulse-agent
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
