[Unit]
Description=Pulse monitoring panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pulse-monitor
Group=pulse-monitor
WorkingDirectory=/opt/pulse-monitor
# Start on loopback, create the owner account, then configure HTTPS for remote access.
ExecStart=/opt/pulse-monitor/pulse-monitor -addr 127.0.0.1:8080 -data /var/lib/pulse-monitor -static /opt/pulse-monitor/out
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/pulse-monitor
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target