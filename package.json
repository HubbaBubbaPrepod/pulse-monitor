  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "typescript": "^5.9.0"
  }
